#!/bin/sh
# TGBP pre-commit (T-003): บล็อก Anthropic API key และไฟล์ > 24 MB (CLAUDE.md §5.1)
# เปิดใช้: git config core.hooksPath .githooks
MAX_BYTES=$((24 * 1024 * 1024))
fail=0

# 1) ห้ามมี key (sk-ant- ตามด้วยตัวอักษรจริง) ในเนื้อหาที่ staged
if git diff --cached --no-color -U0 --diff-filter=ACMR | grep -E '^\+' | grep -Eq 'sk-ant-[A-Za-z0-9_-]{8,}'; then
  echo "pre-commit: พบสตริงคล้าย Anthropic API key (sk-ant-...) ใน staged changes — ยกเลิก commit" >&2
  git diff --cached --no-color -U0 --diff-filter=ACMR -G'sk-ant-[A-Za-z0-9_-]{8,}' --name-only >&2
  fail=1
fi

# 2) ห้ามไฟล์ใหญ่เกิน 24 MB
git diff --cached --name-only -z --diff-filter=ACMR | while IFS= read -r -d '' f; do
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "pre-commit: ไฟล์ใหญ่เกิน 24 MB: $f ($size bytes)" >&2
    exit 1
  fi
done || fail=1

# 3) ห้าม stage ข้อมูลดิบ / env
if git diff --cached --name-only --diff-filter=ACMR | grep -Eq '(^|/)\.env(\.|$)' && \
   ! git diff --cached --name-only --diff-filter=ACMR | grep -Eq '^\.env\.example$'; then
  echo "pre-commit: ห้าม commit ไฟล์ .env*" >&2
  fail=1
fi

exit $fail
