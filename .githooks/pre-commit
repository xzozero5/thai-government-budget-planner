#!/usr/bin/env bash
# TGBP pre-commit (T-003): บล็อก Anthropic API key, ไฟล์ > 24 MB, ไฟล์ .env* (CLAUDE.md §5.1)
# เปิดใช้ครั้งแรกหลัง clone: git config core.hooksPath .githooks
MAX_BYTES=$((24 * 1024 * 1024))
fail=0

# 1) ห้ามมี key (sk-ant- ตามด้วยตัวอักษรจริง) ในบรรทัดที่เพิ่มเข้ามา
if git diff --cached --no-color -U0 --diff-filter=ACMR | grep -E '^\+' | grep -Eq 'sk-ant-[A-Za-z0-9_-]{8,}'; then
  echo "pre-commit: พบสตริงคล้าย Anthropic API key (sk-ant-...) ใน staged changes — ยกเลิก commit" >&2
  fail=1
fi

# 2) ห้ามไฟล์ใหญ่เกิน 24 MB  3) ห้าม .env* (ยกเว้น .env.example)
while IFS= read -r -d '' f; do
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt "$MAX_BYTES" ]; then
    echo "pre-commit: ไฟล์ใหญ่เกิน 24 MB: $f ($size bytes)" >&2
    fail=1
  fi
  base=${f##*/}
  case "$base" in
    .env.example) ;;
    .env | .env.*)
      echo "pre-commit: ห้าม commit ไฟล์ env: $f" >&2
      fail=1
      ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

exit $fail
